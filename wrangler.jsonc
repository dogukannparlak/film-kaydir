// Cloudflare Workers yayın ayarı: derleme yok. public/ statik site, src/worker.js yalnız /api/tmdb/* için çalışır
// (dosyası olmayan adresler Worker'a düşer). TMDB anahtarı burada değil, panelde secret TMDB_KEY olarak durur.
{
  "name": "kaydir",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // /api/tmdb/* için IP başına dakikada 600 istek (Letterboxd aktarımı ~600 istek/dk'ya kadar çıkabilir)
  "ratelimits": [
    { "name": "TMDB_RL", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ]
}
